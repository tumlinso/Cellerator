@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET Cellerator::nn)
    find_dependency(Cellerator CONFIG REQUIRED COMPONENTS nn)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CelleratorNNModulesTargets.cmake")

# CMake 3.28 exports a file-set include list relative to this package prefix.
# The module imports canonical Cellerator headers from a separate dependency
# package, so forward those dependency include directories directly.
set_property(TARGET CelleratorNNModules::nn
    PROPERTY IMPORTED_CXX_MODULES_INCLUDE_DIRECTORIES
        "$<TARGET_PROPERTY:Cellerator::nn,INTERFACE_INCLUDE_DIRECTORIES>")
