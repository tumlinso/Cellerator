# Local fixture payloads. The scaffold under data/test is tracked, but large
# biological inputs and generated conversion outputs remain local.
/data/**/*.h5ad
/data/**/*.csh5
/data/**/*.mtx
/data/**/*.npy
/data/**/*.npz
/data/**/*.bam
/data/**/*.bai
/data/**/*.cram
/data/**/*.crai
/data/**/*.fastq
/data/**/*.fastq.gz
/data/**/*.fq
/data/**/*.fq.gz
/data/**/*.fasta
/data/**/*.fasta.gz
/data/**/*.fa
/data/**/*.fa.gz
/data/test/reference/*
!/data/test/reference/.gitkeep
/data/test/generated/csh5/*
!/data/test/generated/csh5/.gitkeep
/data/test/generated/cache/*
!/data/test/generated/cache/.gitkeep
/data/test/generated/blocked_ell_optimization/*
!/data/test/generated/blocked_ell_optimization/.gitkeep
/data/test/generated/logs/*
!/data/test/generated/logs/.gitkeep
/data/test/generated/tmp/*
!/data/test/generated/tmp/.gitkeep

/.quarto/
**/*.quarto_ipynb
**/.kda-experiments.lock

# Source-bound sparse support qualification summaries; raw profiler reports and
# build outputs remain ignored by their existing rules.
!bench/sparse_support/evidence/*.json
!bench/sparse_support/evidence/*.jsonl
!bench/sparse_support/evidence/*.md
!bench/sparse_support/evidence/*.txt

# Reproducible large inputs and built experiment artifacts stay local; retain
# their manifests, hashes, generators, and checkpoint notes in Git.
/bench/sparse_support/**/*.bin
/bench/sparse_support/**/*.cegeo
/bench/sparse_support/**/prepared_images/prepared_images.json
/bench/sparse_support/**/cellerator_sparse_support_cuda_indexing_bench
/bench/sparse_support/**/geometry_image_probe
/bench/sparse_support/**/validator_differential_probe
/bench/sparse_support/**/validator_scaling_probe
/bench/sparse_support/**/scaled_condition_probe
/bench/sparse_support/**/trusted-inputs/frozen_torch_extension
/bench/sparse_support/**/trusted-inputs/image_manifest
/docs/sparse_support_foundation/evaluation.html
/docs/sparse_support_foundation/evaluation_files/

