# Documentation sources are tracked normally; ignore generated render outputs.
/docs/_book/
/docs/.quarto/
/docs/**/.ipynb_checkpoints/
/docs/sparse_support_foundation/evaluation.html
/docs/sparse_support_foundation/evaluation_files/
._*

# Generated build trees. Anchor root outputs so public build/resource
# namespaces remain ordinary source; experiment-local outputs are explicit.
/build/
/build-*/
/cmake-build-*/
/out/
/bin/
/lib/
/lib64/
/dist/
/bench/**/build/
/bench/**/build-*/
/bench/**/build_*/
/experiments/**/build/
/experiments/**/build-*/
/experiments/**/build_*/

# CMake / make / ninja output
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
compile_commands.json
Makefile
makefile
GNUmakefile
*.make
*.mk
build.ninja
*.ninja
.ninja_deps
.ninja_log
Testing/

