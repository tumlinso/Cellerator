name = "correctness-core-c"
kind = "correctness"
argv = [
  "/home/tumlinson/Software/miniconda3/bin/python",
  "{snapshot}/scripts/validation/autobench_run_framework_v100.py",
  "--source", "{snapshot}", "--build", "{build}/cmake", "--output", "{output}",
  "--mode", "correctness", "--cases", "grouped_linear", "packed_embedding", "reactions",
]
expected_seconds = 60
