@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET Cellerator::headers)
  find_dependency(Cellerator CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ccellModuleProvider.cmake")
if(NOT TARGET ccell::ccell)
  include("${CMAKE_CURRENT_LIST_DIR}/ccellMethodTargets.cmake")
  _ccell_module_provider(ccell::preprocess ccell::preprocess_binary ccell_preprocess_interfaces
    Cellerator::headers)
  _ccell_module_provider(ccell::velocity ccell::velocity_binary ccell_velocity_interfaces
    Cellerator::headers)
  _ccell_module_provider(ccell::ccell ccell::ccell_binary ccell_module_interfaces
    ccell::preprocess ccell::velocity)
endif()
set(ccell_preprocess_FOUND TRUE)
set(ccell_velocity_FOUND TRUE)

if("anndata_interop" IN_LIST ccell_FIND_COMPONENTS)
  set(ccell_anndata_interop_FOUND FALSE)
  if(@CELLERATOR_ENABLE_CCELL_ANNDATA@)
    if(NOT TARGET anndatapp::anndatapp)
      if(ccell_FIND_REQUIRED_anndata_interop)
        find_dependency(anndatapp 1.1 CONFIG)
      else()
        find_package(anndatapp 1.1 CONFIG QUIET)
      endif()
    endif()
    if(TARGET anndatapp::anndatapp)
      if(NOT TARGET ccell::anndata_interop)
        include("${CMAKE_CURRENT_LIST_DIR}/ccellAnndataInteropTargets.cmake")
        _ccell_module_provider(ccell::anndata_interop ccell::anndata_interop_binary
          ccell_anndata_interop_interfaces Cellerator::headers anndatapp::anndatapp)
      endif()
      set(ccell_anndata_interop_FOUND TRUE)
    endif()
  elseif(ccell_FIND_REQUIRED_anndata_interop)
    set(ccell_NOT_FOUND_MESSAGE "This CCell installation omits AnnData++ interop.")
  endif()
endif()
check_required_components(ccell)
