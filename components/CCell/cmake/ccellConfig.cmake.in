@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET Cellerator::headers)
  find_dependency(Cellerator CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ccellModuleProvider.cmake")
if(NOT TARGET ccell::ccell)
  include("${CMAKE_CURRENT_LIST_DIR}/ccellMethodTargets.cmake")
  _ccell_module_provider(ccell::preprocess ccell::preprocess_binary ccell_preprocess_interfaces
    Cellerator::headers)
  _ccell_module_provider(ccell::velocity ccell::velocity_binary ccell_velocity_interfaces
    Cellerator::headers)
  _ccell_module_provider(ccell::ccell ccell::ccell_binary ccell_module_interfaces
    ccell::preprocess ccell::velocity)
endif()
set(ccell_preprocess_FOUND TRUE)
set(ccell_velocity_FOUND TRUE)

check_required_components(ccell)
