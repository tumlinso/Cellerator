if(NOT TARGET Cellerator::sequence)
    if("@CELLERATOR_HAS_CUDA@")
        include(CMakeFindDependencyMacro)
        find_dependency(CUDAToolkit)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/CelleratorSequenceTargets.cmake")
    if("@CELLERATOR_ENABLE_MODULES@")
        include("${CMAKE_CURRENT_LIST_DIR}/CelleratorSequenceModuleTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/CelleratorModuleInterfaces.cmake")
        cellerator_attach_module(Cellerator::sequence cellerator_sequence_module)
    endif()
endif()
set(Cellerator_sequence_FOUND TRUE)
