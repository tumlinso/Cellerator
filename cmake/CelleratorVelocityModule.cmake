include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CelleratorModuleInterfaces.cmake")

# Link the implementation archive without importing a second module build.
function(cellerator_import_velocity)
    if(TARGET Cellerator::velocity)
        return()
    endif()
    add_library(cellerator_velocity_archive STATIC IMPORTED GLOBAL)
    get_target_property(configs Cellerator::velocity_binary IMPORTED_CONFIGURATIONS)
    if(configs)
        set_property(TARGET cellerator_velocity_archive PROPERTY IMPORTED_CONFIGURATIONS "${configs}")
    endif()
    foreach(property IN ITEMS IMPORTED_LOCATION IMPORTED_LINK_INTERFACE_LANGUAGES)
        get_property(present TARGET Cellerator::velocity_binary PROPERTY ${property} SET)
        if(present)
            get_target_property(value Cellerator::velocity_binary ${property})
            set_property(TARGET cellerator_velocity_archive PROPERTY ${property} "${value}")
        endif()
        foreach(config IN LISTS configs)
            get_property(present TARGET Cellerator::velocity_binary PROPERTY ${property}_${config} SET)
            if(present)
                get_target_property(value Cellerator::velocity_binary ${property}_${config})
                set_property(TARGET cellerator_velocity_archive PROPERTY ${property}_${config} "${value}")
            endif()
        endforeach()
    endforeach()
    set_property(TARGET cellerator_velocity_archive PROPERTY INTERFACE_LINK_LIBRARIES
        "velocitypp::velocitypp;Cellerator::binary16")
    cellerator_import_module(velocity Cellerator::velocity_binary
        cellerator_velocity_archive velocitypp::velocitypp Cellerator::binary16)
endfunction()
