set(_ce_selected "")
function(_ce_select component)
  if(NOT component IN_LIST _ce_known)
    message(FATAL_ERROR "Unknown Cellerator substrate component: ${component}")
  endif()
  get_property(selected GLOBAL PROPERTY CE_SUBSTRATE_SELECTED)
  if(component IN_LIST selected)
    return()
  endif()
  foreach(dependency IN LISTS _ce_deps_${component})
    _ce_select(${dependency})
  endforeach()
  set_property(GLOBAL APPEND PROPERTY CE_SUBSTRATE_SELECTED ${component})
endfunction()
set_property(GLOBAL PROPERTY CE_SUBSTRATE_SELECTED "")
foreach(component IN LISTS CELLERATOR_SUBSTRATE_COMPONENTS)
  _ce_select(${component})
endforeach()
get_property(_ce_selected GLOBAL PROPERTY CE_SUBSTRATE_SELECTED)

if(native_numeric_sm70 IN_LIST _ce_selected)
  if(NOT CELLERATOR_SUBSTRATE_ENABLE_SM70)
    message(FATAL_ERROR "native_numeric_sm70 requires CELLERATOR_SUBSTRATE_ENABLE_SM70=ON")
  endif()
  # Explicit qualification toolchain: no silent CUDA 13 or architecture upgrade.
  set(CMAKE_CUDA_ARCHITECTURES 70 CACHE STRING "Substrate CUDA architecture" FORCE)
  enable_language(CUDA)
  find_package(CUDAToolkit 12 REQUIRED)
  if(CUDAToolkit_VERSION VERSION_GREATER_EQUAL 13 OR CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 13)
    message(FATAL_ERROR "Substrate SM70 requires CUDA 12.x")
  endif()
endif()
