endif()

function(_ce_owner name)
  cmake_parse_arguments(ARG "" "CAPABILITIES" "SOURCES;INCLUDES" ${ARGN})
  if(ARG_SOURCES)
    set(sources)
    foreach(source IN LISTS ARG_SOURCES)
      list(APPEND sources "${CE_SUBSTRATE_ROOT}/${source}")
    endforeach()
    add_library(cellerator_substrate_${name} STATIC ${sources})
    set(scope PUBLIC)
  else()
    add_library(cellerator_substrate_${name} INTERFACE)
    set(scope INTERFACE)
  endif()
  set(target cellerator_substrate_${name})
  add_library(Cellerator::${name} ALIAS ${target})
  set_target_properties(${target} PROPERTIES EXPORT_NAME ${name}
    CELLERATOR_CAPABILITIES "${ARG_CAPABILITIES}" EXPORT_PROPERTIES CELLERATOR_CAPABILITIES)
  target_compile_features(${target} ${scope} cxx_std_20)
  target_include_directories(${target} ${scope}
    $<BUILD_INTERFACE:${CE_SUBSTRATE_ROOT}/include> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
  foreach(path IN LISTS ARG_INCLUDES)
    target_include_directories(${target} ${scope} $<BUILD_INTERFACE:${CE_SUBSTRATE_ROOT}/${path}>)
  endforeach()
  foreach(dependency IN LISTS _ce_deps_${name})
    target_link_libraries(${target} ${scope} Cellerator::${dependency})
  endforeach()
  if(ARG_SOURCES AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fno-fast-math;-ffp-contract=off>)
  endif()
  install(TARGETS ${target} EXPORT Cellerator_${name} ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  install(EXPORT Cellerator_${name} FILE Cellerator_${name}Targets.cmake
    NAMESPACE Cellerator:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Cellerator)
endfunction()
foreach(component IN LISTS _ce_selected)
  if(component STREQUAL operation_schema)
    _ce_owner(${component} CAPABILITIES "native_v2_contract_validation" SOURCES src/compute/operation/operation_core_v2/schema.cc)
  elseif(component STREQUAL host_operation_contracts)
    _ce_owner(${component} CAPABILITIES "native_contracts")
  elseif(component STREQUAL relation_semantics)
    _ce_owner(${component} CAPABILITIES "host_relation_contracts" SOURCES src/compute/operation/relation_semantics.cc)
  elseif(component STREQUAL native_numeric)
    _ce_owner(${component} CAPABILITIES "host_relation,host_f32_f64_local" SOURCES
      src/compute/operation/native_numeric/host_relation.cc src/compute/operation/native_numeric/local_arithmetic.cc)
  elseif(component STREQUAL executable_program)
    _ce_owner(${component} CAPABILITIES "fixed_stage_graph" SOURCES src/execution/program/program_v2.cc)
  elseif(component STREQUAL indexed_incidence)
    _ce_owner(${component} CAPABILITIES "host_ordered_incidence,no_evaluators,no_device_training" SOURCES
      src/compute/operation/indexed_mechanism/incidence.cc)
  elseif(component STREQUAL cellpack)
    _ce_owner(${component} CAPABILITIES "host_geometry_planner,evaluator" SOURCES src/geometry/planner.cc src/geometry/evaluator.cc)
  elseif(component STREQUAL local_differential)
    _ce_owner(${component} CAPABILITIES "host_f32_f64_forward_jvp_vjp,cuda_headers_required" SOURCES
      src/compute/operation/differential/local_arithmetic.cc)
    target_include_directories(cellerator_substrate_${component} SYSTEM PRIVATE "${CE_SUBSTRATE_CUDA_HEADERS}")
  elseif(component STREQUAL moonshot_effects)
    _ce_owner(${component} CAPABILITIES "experimental_host_effects" INCLUDES
      experiments/baseplane_moonshot/include experiments/baseplane_moonshot/families/effects/include)
  elseif(component STREQUAL moonshot_mechanisms)
    _ce_owner(${component} CAPABILITIES "experimental_host_mechanisms" INCLUDES
      experiments/baseplane_moonshot/families/mechanisms/include)
  elseif(component STREQUAL moonshot_learning)
    _ce_owner(${component} CAPABILITIES "experimental_host_learning" INCLUDES experiments/baseplane_moonshot/families/learning)
  elseif(component STREQUAL structured_state)
    _ce_owner(${component} CAPABILITIES "host_borrowed_scalar_ragged_state" SOURCES src/state/structured_state.cc)
  elseif(component STREQUAL packing_strategy)
    _ce_owner(${component} CAPABILITIES "cold_host_identity_supplied_cellpack" SOURCES src/packing/core/strategy.cc)
  elseif(component STREQUAL matrix_patch)
    _ce_owner(${component} CAPABILITIES "host_f32_patch_forward_vjp_jvp" SOURCES
      src/math/matrix/patch.cc experiments/moonshot-parallel-v1/diff/patch/native.cc)
  elseif(component STREQUAL private_ports)
    _ce_owner(${component} CAPABILITIES "host_f32_private_transport_forward_vjp_jvp" SOURCES
      src/math/process/ports.cc experiments/moonshot-parallel-v1/diff/ports/transport.cc)
  elseif(component STREQUAL effects)
    _ce_owner(${component} CAPABILITIES "host_affine_hybrid_effects")
  elseif(component STREQUAL prepared_host)
    _ce_owner(${component} CAPABILITIES "host_f32_f64_prepared_scaled_tanh")
  elseif(component STREQUAL packing_strategies)
    _ce_owner(${component} CAPABILITIES "host_order_preserving_placement" SOURCES src/packing/strategies/placement.cc)
  elseif(component STREQUAL frontier)
    _ce_owner(${component} CAPABILITIES "finite_host_f64_quadratic_solve_ports_multilevel" SOURCES src/math/frontier/operators.cc)
  elseif(component STREQUAL response)
    _ce_owner(${component} CAPABILITIES "host_requested_f32_f64_scaled_tanh" SOURCES src/math/response/requested.cc)
  elseif(component STREQUAL adaptive)
    _ce_owner(${component} CAPABILITIES "host_delta_ledger_serialized_publication" SOURCES src/math/adaptive/reuse.cc)
  elseif(component STREQUAL native_numeric_sm70)
    _ce_owner(${component} CAPABILITIES "cuda12_sm70_device_linear" SOURCES src/compute/operation/native_numeric/device_linear.cu)
    target_link_libraries(cellerator_substrate_${component} PUBLIC CUDA::cudart)
    set_target_properties(cellerator_substrate_${component} PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED YES)
  endif()
endforeach()
