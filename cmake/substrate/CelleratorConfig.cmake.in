@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(Cellerator_AVAILABLE_COMPONENTS "@_ce_selected@")
set(Cellerator_BUILD_SOURCE_REVISION "@CE_SUBSTRATE_SOURCE_REVISION@")
@CE_SUBSTRATE_DEPENDENCY_TABLE@
function(_ce_load component)
  if(NOT component IN_LIST Cellerator_AVAILABLE_COMPONENTS)
    set(Cellerator_${component}_FOUND FALSE PARENT_SCOPE)
    return()
  endif()
  if(TARGET Cellerator::${component})
    set(Cellerator_${component}_FOUND TRUE PARENT_SCOPE)
    return()
  endif()
  set(path "${CMAKE_CURRENT_LIST_DIR}/Cellerator_${component}Targets.cmake")
  if(NOT EXISTS "${path}")
    set(Cellerator_${component}_FOUND FALSE PARENT_SCOPE)
    return()
  endif()
  foreach(dependency IN LISTS _ce_deps_${component})
    _ce_load(${dependency})
    if(NOT TARGET Cellerator::${dependency})
      set(Cellerator_${component}_FOUND FALSE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(component STREQUAL native_numeric_sm70)
    find_package(CUDAToolkit 12 REQUIRED)
    if(CUDAToolkit_VERSION VERSION_GREATER_EQUAL 13)
      message(FATAL_ERROR "Cellerator native_numeric_sm70 requires CUDA 12.x")
    endif()
  endif()
  if(component STREQUAL local_differential)
    find_path(Cellerator_CUDA_HEADERS cuda_runtime_api.h HINTS
      /opt/nvidia/hpc_sdk/Linux_x86_64/26.1/cuda/12.9/include REQUIRED)
  endif()
  include("${path}")
  if(component STREQUAL local_differential)
    set_property(TARGET Cellerator::local_differential APPEND PROPERTY
      INTERFACE_INCLUDE_DIRECTORIES "${Cellerator_CUDA_HEADERS}")
  endif()
  set(Cellerator_${component}_FOUND TRUE PARENT_SCOPE)
endfunction()
if(NOT Cellerator_FIND_COMPONENTS)
  set(Cellerator_FIND_COMPONENTS host_operation_contracts)
endif()
foreach(component IN LISTS Cellerator_FIND_COMPONENTS)
  _ce_load(${component})
endforeach()
check_required_components(Cellerator)
