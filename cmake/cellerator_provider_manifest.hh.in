#pragma once

#include <Cellerator/compute/architecture/provider.hh>

// Declarations are collected only from providers explicitly included by the
// build. They may contain namespace-qualified declarations.
@CELLERATOR_PROVIDER_MANIFEST_DECLARATIONS@

namespace cellerator::compute::architecture {

// The final null entry permits a valid zero-provider generated array. It is
// not included in the manifest count and is never invoked.
inline constexpr provider_registration_function_v1
    compiled_provider_registrations_v1[]{
@CELLERATOR_PROVIDER_MANIFEST_ENTRIES@
        nullptr};

inline constexpr compiled_provider_manifest_v1
    cellerator_compiled_provider_manifest_v1{
        compiled_provider_registrations_v1,
        static_cast<std::uint32_t>(
            sizeof(compiled_provider_registrations_v1)
                / sizeof(compiled_provider_registrations_v1[0])
            - 1u)};

// Compatibility name for callers that consumed the pre-freeze generated
// manifest spelling. It aliases the same immutable span and adds no registry.
inline constexpr compiled_provider_manifest_v1
    compiled_provider_manifest_v1_instance =
        cellerator_compiled_provider_manifest_v1;

} // namespace cellerator::compute::architecture
