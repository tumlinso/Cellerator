if("cuda" IN_LIST anndatapp_FIND_COMPONENTS)
  if(NOT ANNDATAPP_HAS_CUDA)
    set(anndatapp_cuda_FOUND FALSE)
    set(anndatapp_NOT_FOUND_MESSAGE "This anndatapp installation was built without CUDA")
    return()
  endif()
  if(NOT TARGET anndatapp::cuda)
    include(CMakeFindDependencyMacro)
    find_dependency(CUDAToolkit 12)
    include("${CMAKE_CURRENT_LIST_DIR}/anndatappCudaTargets.cmake")
    _anndatapp_module_provider(anndatapp::cuda anndatapp::cuda_binary
      anndatapp_cuda_module_interfaces anndatapp::anndatapp)
  endif()
  set(anndatapp_cuda_FOUND TRUE)
endif()
