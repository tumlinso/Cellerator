# CMake 3.28: one local interface build avoids duplicate imported BMI rules.
function(_anndatapp_module_provider public binary local)
  if(TARGET ${public})
    return()
  endif()
  get_target_property(kind ${binary} TYPE)
  if(kind STREQUAL "STATIC_LIBRARY")
    add_library(${local}_binary STATIC IMPORTED GLOBAL)
  elseif(kind STREQUAL "SHARED_LIBRARY")
    add_library(${local}_binary SHARED IMPORTED GLOBAL)
  else()
    message(FATAL_ERROR "Unsupported anndatapp binary type: ${kind}")
  endif()
  get_target_property(configs ${binary} IMPORTED_CONFIGURATIONS)
  if(configs)
    set_property(TARGET ${local}_binary PROPERTY IMPORTED_CONFIGURATIONS "${configs}")
  endif()
  foreach(property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME
      IMPORTED_NO_SONAME INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
    get_property(present TARGET ${binary} PROPERTY ${property} SET)
    if(present)
      get_target_property(value ${binary} ${property})
      if(property STREQUAL "INTERFACE_LINK_LIBRARIES")
        string(REPLACE "anndatapp::anndatapp_binary" "anndatapp::anndatapp" value "${value}")
      endif()
      set_property(TARGET ${local}_binary PROPERTY ${property} "${value}")
    endif()
  endforeach()
  foreach(config IN LISTS configs)
    foreach(property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME
        IMPORTED_NO_SONAME IMPORTED_LINK_DEPENDENT_LIBRARIES IMPORTED_LINK_INTERFACE_LANGUAGES)
      get_property(present TARGET ${binary} PROPERTY ${property}_${config} SET)
      if(present)
        get_target_property(value ${binary} ${property}_${config})
        set_property(TARGET ${local}_binary PROPERTY ${property}_${config} "${value}")
      endif()
    endforeach()
  endforeach()
  get_target_property(files ${binary} CXX_MODULE_SET)
  get_target_property(dirs ${binary} CXX_MODULE_DIRS)
  add_library(${local} STATIC EXCLUDE_FROM_ALL)
  set_target_properties(${local} PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
  target_sources(${local} PUBLIC FILE_SET CXX_MODULES BASE_DIRS ${dirs} FILES ${files})
  target_link_libraries(${local} PUBLIC ${local}_binary ${ARGN})
  foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_FEATURES COMPILE_OPTIONS INCLUDE_DIRECTORIES)
    foreach(prefix IN ITEMS IMPORTED_CXX_MODULES INTERFACE)
      get_property(present TARGET ${binary} PROPERTY ${prefix}_${property} SET)
      if(present)
        get_target_property(value ${binary} ${prefix}_${property})
        set_property(TARGET ${local} APPEND PROPERTY ${property} "${value}")
        if(prefix STREQUAL "INTERFACE")
          set_property(TARGET ${local} APPEND PROPERTY INTERFACE_${property} "${value}")
        endif()
      endif()
    endforeach()
  endforeach()
  add_library(${public} INTERFACE IMPORTED GLOBAL)
  set_property(TARGET ${public} PROPERTY INTERFACE_LINK_LIBRARIES ${local})
endfunction()
