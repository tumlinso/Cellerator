if("cuda" IN_LIST velocity_FIND_COMPONENTS)
  if(NOT VELOCITY_HAS_CUDA)
    set(velocity_cuda_FOUND FALSE)
    set(velocity_NOT_FOUND_MESSAGE "This velocity installation was built without CUDA")
    return()
  endif()
  if(NOT TARGET velocity::cuda)
    find_dependency(anndata 0.1 CONFIG COMPONENTS cuda)
    find_dependency(CUDAToolkit 12)
    include("${CMAKE_CURRENT_LIST_DIR}/velocityCudaTargets.cmake")
    _velocity_module_provider(velocity::cuda velocity::cuda_binary
      velocity_cuda_module_interfaces velocity::velocity anndata::cuda)
  endif()
  set(velocity_cuda_FOUND TRUE)
endif()
