@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(anndata 0.1 CONFIG)
set(VELOCITY_HAS_CUDA @VELOCITY_ENABLE_CUDA@)
set(VELOCITY_CPU_ISA "@VELOCITY_CPU_ISA@")
include("${CMAKE_CURRENT_LIST_DIR}/velocityModuleProvider.cmake")
if(NOT TARGET velocity::velocity)
  include("${CMAKE_CURRENT_LIST_DIR}/velocityTargets.cmake")
  _velocity_module_provider(velocity::velocity velocity::velocity_binary
    velocity_module_interfaces anndata::anndata)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/velocityCudaConfig.cmake")
check_required_components(velocity)
