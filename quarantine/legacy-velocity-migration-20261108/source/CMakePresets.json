{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug",
     "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++-18", "CMAKE_BUILD_TYPE": "Debug",
       "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/install"}},
    {"name": "native-check", "inherits": "debug", "binaryDir": "${sourceDir}/build/native"},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/build/release",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "VELOCITY_BUILD_QUALIFICATION": "ON"}},
    {"name": "sanitizers", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitizers",
     "cacheVariables": {"VELOCITY_ENABLE_SANITIZERS": "ON"}},
    {"name": "shared", "inherits": "debug", "binaryDir": "${sourceDir}/build/shared",
     "cacheVariables": {"BUILD_SHARED_LIBS": "ON"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug", "jobs": 2},
    {"name": "native-check", "configurePreset": "native-check", "jobs": 2},
    {"name": "release", "configurePreset": "release", "jobs": 2},
    {"name": "sanitizers", "configurePreset": "sanitizers", "jobs": 2},
    {"name": "shared", "configurePreset": "shared", "jobs": 2}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "native-check", "configurePreset": "native-check", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "sanitizers", "configurePreset": "sanitizers", "output": {"outputOnFailure": true},
     "environment": {"ASAN_OPTIONS": "detect_leaks=0", "UBSAN_OPTIONS": "halt_on_error=1"}},
    {"name": "shared", "configurePreset": "shared", "output": {"outputOnFailure": true}}
  ],
  "workflowPresets": [
    {"name": "native-check", "steps": [{"type": "configure", "name": "native-check"}, {"type": "build", "name": "native-check"}, {"type": "test", "name": "native-check"}]}
  ]
}
