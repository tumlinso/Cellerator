{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nf1:capability-receipt-v1",
  "title": "NF1 runtime capability receipt (not native Todo schema)",
  "type": "object",
  "required": [
    "kind",
    "status",
    "edge_id",
    "capability",
    "producer_project",
    "producer_uuid",
    "producer_run",
    "producer_task",
    "source_commit",
    "source_files",
    "interfaces",
    "test_receipts"
  ],
  "properties": {
    "kind": {
      "const": "nf1-capability-receipt-v1"
    },
    "status": {
      "const": "qualified"
    },
    "edge_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "producer_project": {
      "enum": [
        "cellerator",
        "glasshelix"
      ]
    },
    "producer_uuid": {
      "type": "string"
    },
    "producer_run": {
      "type": "string"
    },
    "producer_task": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "test_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "numerical_policy": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "peer_dependency": {
      "type": "object"
    }
  }
}
