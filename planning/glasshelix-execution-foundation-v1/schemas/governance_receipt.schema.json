{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "task_id",
    "reviewed",
    "source_commit",
    "reviewer_lane",
    "topics",
    "artifacts"
  ],
  "properties": {
    "kind": {
      "const": "nf1-governance-receipt-v1"
    },
    "task_id": {
      "type": "string"
    },
    "reviewed": {
      "const": true
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewer_lane": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
