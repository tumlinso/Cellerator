  "invariants": [
    {
      "id": "CE-RU1-INV-SCOPE",
      "rule": "Extend one canonical prepared relation through N16 VJP, update, publication and reuse; retain N1. No broad compiler, planner, geometry, SDK or ML framework program.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-SEMANTICS",
      "rule": "One mathematical meaning from native and compiler origins. Biological axes, topology and exact support persist; pointers, streams, generations, provenance and selected kernels are binding/realization facts.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-NUMERIC",
      "rule": "f16 relation values with f32 accumulation. Half rounding of gradient operands requires explicit profile permission and is identical for sparse and WMMA. No silent conversion or gradient-through-rounding claim.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-IDENTITY",
      "rule": "Keep persistent edge order through gradient/update. Changing values never rebuilds topology. Observe logical order only at an explicit boundary.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-LIFETIME",
      "rule": "One owner execution stream and serialized host API; one bounded external const reader lease. Producer readiness and reader completion are both ordered before in-place mutation; no historical immutable generation illusion.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-WMMA",
      "rule": "Required repaired and executable sm70 N16 WMMA plus exact sparse residual/fallback. Force overrides profitability only. Selection and performance claims require phase-complete evidence.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-PRESERVE",
      "rule": "Move useful algorithms into shared core. Compatibility has no entitlement, but no useful code or unrelated consumer is lost by pruning.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-EVIDENCE",
      "rule": "No mock, reference-only run, skipped GPU, capability name or unlinked declaration may satisfy accelerator acceptance. Enqueue is not observed completion.",
      "severity": "error"
    },
    {
      "id": "CE-RU1-INV-AUTHORITY",
      "rule": "Package ingestion does not activate a run or authorize implementation. Preserve unrelated worktrees, authority, runs and pending patches; local workers are not first-class lanes.",
      "severity": "error"
    }
  ],
