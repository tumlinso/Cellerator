      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-NO-CLANG-FORK",
      "rule": "Cellerator is its own driver/frontend and may use upstream Clang libraries or clangd processes through versioned adapters; no permanent Clang fork is the architectural foundation.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-BACKEND-AGNOSTIC",
      "rule": "Semantic IR is independent of GCC, Clang, NVCC, LLVM, and PTX; target and toolchain specificity increases only in Planning and Realization IR and backend layers.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-ORDINARY-OBJECTS",
      "rule": "AOT compilation produces ordinary platform object and executable artifacts; CEIR companion metadata may be embedded or sidecar but does not require a bespoke universal executable container.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PRAGMA-FILE-LOCAL",
      "rule": "#pragma cellerator enables the language only from the directive to the end of that physical file/include instance and never leaks through include boundaries; file extension is not the semantic switch.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-CXX-FALLTHROUGH",
      "rule": "Unactivated ordinary C/C++ follows the selected downstream compiler with no Cellerator semantic compilation; activated source remains interoperable with ordinary C/C++ code and opaque/effect-contracted native calls.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-SMALL-LANGUAGE",
      "rule": "Only information intrinsically reasoned about by the compiler belongs in the base language; higher constructions are Cellerator standard-library code written in .cell where practical.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-BIOLOGICAL-IDENTITY",
      "rule": "Shape never establishes biological equivalence. Domain, axis, order, geometry, partition, relation, logical edge, structure epoch, value generation, and support generation remain explicit where relevant.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-TYPED-OPS",
      "rule": "Numeric/storage/compute/accumulation/output types and operation semantics participate before candidate selection; half, bf16, float, and double may legitimately produce different operations and realizations.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-LOW-LEVEL-FREEDOM",
      "rule": "Cellerator remains low-level and explicit. Compiler-semantic types prevent meaningful errors but do not impose a closed biological ontology or remove ordinary pointer, template, custom layout, and native-code control.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-EXPLICIT-FIELDS",
      "rule": "Execution fields explicitly authorize joint biological planning; optimization does not silently cross field, C++ observable-effect, or uncontracted native-call boundaries.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PROFILE-REQUIRED",
      "rule": "Activated biological semantic compilation requires an explicitly bound representative profile environment. Pure C++ fallthrough and structural CEIR tooling are exempt; generic reference profiles are never silently selected.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-DATA-DERIVED-PROFILES",
      "rule": "Representative profiles are data-derived compiler evidence optimized for fast expressive analysis; they do not encode hand-authored execution policy or concrete runtime pointers.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-CONTROL-HIERARCHY",
      "rule": "Programmer authority progresses from automatic optimization through facts, preferences, hard constraints, custom candidates/decompositions, forced plans, writable IR, replacement passes, and manual/native realization.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PUBLIC-WRITABLE-IR",
      "rule": "Semantic, Planning, and Realization IR are public, human-readable, textually programmable, directly compilable, writable, reflectable, inlineable, extensible, and replaceable programming surfaces.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-CEIR-NATIVE",
      "rule": "CEIR belongs to Cellerator. LLVM IR, MLIR, generated C++, CUDA, PTX, and machine code may implement or follow it but never substitute for the public Cellerator IR family.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-EXACT-COVERAGE",
      "rule": "Approximate evidence may propose atoms and decompositions, but execution admission requires independently certified exact coverage, contribution ownership, canonical recovery, and compatible partial-result algebra.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-COMPLETE-COST",
      "rule": "Compiler decisions expose complete cost including compilation, preparation, conversion, packing, transfer, memory, launches, synchronization, execution, residuals, canonicalization, and reuse amortization where relevant.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-HOT-COLD-SEPARATION",
      "rule": "Cold IR, provenance, profile, discovery, planning, and artifact metadata never force runtime parsing, discovery, allocation, global sorting, or pointer-rich metadata into sealed hot execution paths.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-EXPERT-CONTROL",
      "rule": "Every major compiler mechanism remains accessible to expert code, including profiles, decomposition, candidates, costs, passes, physical layout, stage graphs, native operations, and direct PTX where technically meaningful.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-NO-PATERNALISM",
      "rule": "Validators diagnose aggressively, but trusted, unsafe, unchecked, forced, and raw continuation remain available whenever the representation and backend can technically proceed; only structural impossibility must hard-fail.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PROVENANCE-COLD",
      "rule": "Source-to-native provenance is recoverable through compile-time sidecars or removable artifact metadata and imposes no mandatory hot-path runtime overhead.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-EXPLICIT-MECHANICS",
      "rule": "Diagnostics, reflection, and IR expose inferred biology, profile state, generations, alternatives, costs, rejections, decomposition, realization, and backend output instead of presenting compiler decisions as magic.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-SHARED-COMPILER-LIBS",
      "rule": "cellerator and celleratord share source, parser, AST, Sema, CEIR, profile, diagnostics, and query libraries; celleratord does not reverse-engineer a monolithic compiler executable.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-RUNTIME-ACCESS",
      "rule": "Programmers who never adopt the Cellerator language retain direct supported access to useful runtime, operation, geometry, planner, prepared-program, session, readiness, and provider APIs.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-STDLIB-CELL",
      "rule": "The standard-library foundation is compiled Cellerator source with .cell preferred. Base language semantics are not hidden as ordinary classes merely for implementation convenience.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-NEGATIVE-RESULTS",
      "rule": "Experimental candidates, backends, discovery strategies, and optimizations may validly complete as evaluated-not-promoted when exactness and complete-cost evidence do not justify promotion.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PERFORMANCE",
      "rule": "Performance is the governing criterion, measured at complete compiler and execution cost rather than aesthetic simplicity or isolated kernel time; explicit low-level complexity is acceptable when progressively exposed.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-SPEC-MUTABLE",
      "rule": "Current language and IR documents guide implementation but may be reconciled when source evidence or validated implementation exposes contradictions; performance, control, modern architecture, and explicit semantics govern.",
      "severity": "error",
      "scope": {
        "program": "CE-CCP1"
      }
    },
    {
      "id": "CE-CCP1-INV-PART-TWO-DEFERRED",
      "rule": "General JIT/runtime compilation and deep CellShard materialization, persistence, placement, residency, transport, and runtime evolution remain Part Two except for narrow versioned seams required by Part One.",
