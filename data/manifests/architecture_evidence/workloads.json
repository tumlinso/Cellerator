{
  "schema_version": 1,
  "generator_contract": {
    "algorithm": "splitmix64-structural-v1",
    "value_semantics": "structure_only",
    "matrix_orientation": "rows_are_source_or_observation_axis; columns_are_destination_or_feature_axis",
    "large_output": "Matrix Market pattern matrices are local and gitignored; committed compact JSON traces are capped at 1000000 edges"
  },
  "operation_regimes": {
    "dense_width_n": [1, 2, 3, 4, 7, 8, 16, 24, 32, 64, 96, 128, 256, 512],
    "required_power_of_two_n": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512],
    "required_non_power_of_two_n": [3, 7, 24, 96],
    "numeric_policies": [
      "bit_or_integer_predicate_only",
      "fp16_storage_fp32_accumulation",
      "bf16_storage_fp32_accumulation",
      "fp32_storage_fp32_accumulation"
    ],
    "activation_rule": "Measure only numeric policies advertised by every selected candidate; fp8 and quantized policies remain deferred until implemented."
  },
